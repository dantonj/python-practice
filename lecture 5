def profit_calc(revenue, expenses):
    profit = revenue - expenses
    return profit


def profit_margin_calc(profit, revenue):
    if revenue == 0:
        return 0
    return (profit / revenue) * 100


def test_profit_calc():
    assert profit_calc(10000, 6500) == 3500
    assert profit_calc(5000, 5000) == 0
    assert profit_calc(2000, 3000) == -1000
    assert profit_calc(10000, 0) == 10000
    assert profit_calc(0, 0) == 0


def test_profit_margin_calc():
    assert profit_margin_calc(3500, 10000) == 35
    assert profit_margin_calc(0, 5000) == 0
    assert profit_margin_calc(-1000, 2000) == -50
    assert profit_margin_calc(10000, 10000) == 100
    assert profit_margin_calc(0, 0) == 0
